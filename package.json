{
  "name": "clearway",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Clearway: an AI agent that screens US airports for terminal investment, with deterministic scoring and sourced answers.",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "data:refresh": "tsx --env-file=.env apps/api/src/jobs/refresh-cli.ts",
    "data:import": "tsx --env-file=.env apps/api/src/data/imports/cli.ts",
    "dev:api": "tsx watch --env-file=.env apps/api/src/dev.ts",
    "dev:web": "npm run dev -w @clearway/web",
    "ask": "tsx --env-file=.env apps/api/src/agent/ask-cli.ts",
    "eval": "tsx --env-file=.env apps/api/src/agent/eval.ts",
    "smoke": "tsx apps/api/src/smoke.ts",
    "deploy": "sst deploy --stage prod"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "drizzle-kit": "^0.31.11",
    "sst": "^4.17.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
